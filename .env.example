# --- Backend configuration ---
# Path to the SQLite database file
DATABASE_PATH=./documind.db

# Max upload size in bytes (5 MB default)
MAX_UPLOAD_SIZE=5242880

# Path to the trained model artifacts directory (produced by ml/train.py)
MODEL_DIR=./ml/model

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# --- Frontend configuration (set in frontend/.env, NOT this file) ---
# REACT_APP_API_BASE_URL=http://localhost:8000
